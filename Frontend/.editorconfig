# EditorConfig is awesome: https://EditorConfig.org

# 顶级配置文件
root = true

# 所有文件的默认设置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 文件
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON 文件
[*.json]
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_size = 2

# Shell 脚本
[*.sh]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# TypeScript/JavaScript/Vue 文件
[*.{ts,js,vue}]
indent_size = 2
max_line_length = 100

# CSS/SCSS 文件
[*.{css,scss,sass,less}]
indent_size = 2

# HTML 文件
[*.html]
indent_size = 2
