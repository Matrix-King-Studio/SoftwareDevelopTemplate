{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:dev": "vue-tsc -b && vite build --mode development",
    "build:test": "vue-tsc -b && vite build --mode test",
    "build:prod": "vue-tsc -b && vite build --mode prod",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss,md}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss,md}\" \"*.{js,ts,json,md}\"",
    "// --- 单元测试 (Vitest) ---": "",
    "test:unit": "vitest",
    "// --- E2E 测试 (Playwright) ---": "",
    "// 1. 这种模式可以在后台静默运行，适合 CI/CD 和快速检查": "",
    "test:e2e": "playwright test",
    "// 2. 这种模式会弹出一个浏览器窗口，让你看着它自动点点点 (调试用)": "",
    "test:e2e:headed": "playwright test --headed",
    "// 3. 这种模式会打开超级好用的 UI 界面，能回放、能看报错截图": "",
    "test:e2e:ui": "playwright test --ui",
    "// 4. 录制新测试用例": "",
    "test:record": "playwright codegen http://localhost:8081",
    "prepare": "cd .. && husky install"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tailwindcss/vite": "^4.1.3",
    "axios": "^1.6.5",
    "element-plus": "^2.8.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "prettier": "^3.7.4",
    "sass-embedded": "^1.70.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.2.6"
  }
}
