#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

ROOT_DIR="$(git rev-parse --show-toplevel)"
. "$ROOT_DIR/scripts/git-hooks/common.sh"

cd "$ROOT_DIR"

# 开关:总开关 HOOKS_ENABLED 或分项 HOOKS_PRE_PUSH 为否时放行(配置见 .git-hooks.config)。
if ! is_hook_enabled HOOKS_PRE_PUSH; then
  print_skip "pre-push 已被开关禁用(HOOKS_ENABLED / HOOKS_PRE_PUSH),跳过检查"
  exit 0
fi

echo "=== Pre-push 代码质量检查 ==="

REMOTE_NAME="${1:-origin}"

# 收集本次推送涉及的变更文件列表(跨多个 ref 累积)。
CHANGED_FILE_LIST="$(mktemp)"
trap 'rm -f "$CHANGED_FILE_LIST"' EXIT

append_diff_files() {
  git diff --name-only "$1" "$2" >> "$CHANGED_FILE_LIST"
}

# git 通过 stdin 传入每个待推送 ref:<local_ref> <local_oid> <remote_ref> <remote_oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_ref:-}" ] || continue

  # 删除分支(local_oid 全零)无需检查。
  if is_zero_oid "$local_oid"; then
    continue
  fi

  if is_zero_oid "$remote_oid"; then
    # 新分支首次推送:与远端默认分支的 merge-base 比较,得出真正新增的提交差异。
    REMOTE_HEAD_REF="$(git symbolic-ref "refs/remotes/$REMOTE_NAME/HEAD" 2>/dev/null || true)"
    if [ -n "$REMOTE_HEAD_REF" ]; then
      MERGE_BASE="$(git merge-base "$local_oid" "$REMOTE_HEAD_REF" 2>/dev/null || true)"
      if [ -n "$MERGE_BASE" ]; then
        append_diff_files "$MERGE_BASE" "$local_oid"
        continue
      fi
    fi
    # 无法确定 merge-base 时,保守起见全量检查。
    printf '__RUN_ALL__\n' >> "$CHANGED_FILE_LIST"
    continue
  fi

  append_diff_files "$remote_oid" "$local_oid"
done

if [ ! -s "$CHANGED_FILE_LIST" ]; then
  print_skip "未检测到需要推送的变更,跳过"
  exit 0
fi

sort -u "$CHANGED_FILE_LIST" -o "$CHANGED_FILE_LIST"

RUN_ALL=0
if grep -qx '__RUN_ALL__' "$CHANGED_FILE_LIST"; then
  RUN_ALL=1
fi

# 模块是否需要检查:全量模式直接命中,否则看变更文件是否落在该模块路径下。
needs_module_check() {
  [ "$RUN_ALL" = "1" ] && return 0
  grep -Eq "^$1" "$CHANGED_FILE_LIST"
}

# ─── Frontend:构建校验 ───────────────────────────────────
if needs_module_check 'Frontend/'; then
  ensure_command npm
  print_section "Frontend: build 校验..."
  (
    cd Frontend || exit 1
    npm run build
  ) || { print_error "Frontend 构建失败!"; exit 1; }
else
  print_skip "Frontend: 无推送变更,跳过"
fi

# ─── Backend:全量 ruff + Django 单元测试 ─────────────────
if needs_module_check 'Backend/'; then
  ensure_command ruff
  print_section "Backend: 全量 Ruff 检查..."
  (
    cd Backend || exit 1
    make lint
  ) || { print_error "Backend Ruff 检查失败!"; exit 1; }

  BACKEND_PYTHON="$(detect_python_command || true)"
  if [ -z "$BACKEND_PYTHON" ]; then
    print_error "未检测到可用的 Python 命令,无法执行 Backend Django 测试。"
    echo "  请先安装 Python 3,并在 Backend 环境中安装 requirements.txt 依赖。"
    exit 1
  fi

  if ! python_has_module "$BACKEND_PYTHON" django; then
    print_error "当前 Python 环境未安装 Django,无法执行 Backend Django 测试。"
    echo "  建议执行: cd Backend && $BACKEND_PYTHON -m pip install -r requirements.txt"
    exit 1
  fi

  # 固定使用 unittest settings:内存 SQLite + 本地内存缓存,不连接任何 MySQL / Redis。
  # 指向 Backend/apps 做 discovery:覆盖该目录下所有 app 的 tests(与 Makefile 的 test 目标一致)。
  print_section "Backend: Django 单元测试 (Backend.settings.unittest)..."
  (
    cd Backend || exit 1
    DJANGO_SETTINGS_MODULE="Backend.settings.unittest" "$BACKEND_PYTHON" manage.py test Backend/apps
  ) || { print_error "Backend Django 单元测试失败!"; exit 1; }
else
  print_skip "Backend: 无推送变更,跳过"
fi

echo ""
echo "=== 所有检查通过 ==="
