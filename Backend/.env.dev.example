# 本地开发环境配置。settings 会在 Backend.settings.dev 加载时读取本文件。
# 系统环境变量优先级更高；本文件只补默认值。

# Django 签名密钥。开发环境可使用默认模板值,真实项目建议单独生成。
SECRET_KEY=dev_django_secret_key

# 允许访问的 Host,多个值用英文逗号分隔。开发环境默认放开。
ALLOWED_HOSTS=*

# 允许提交 CSRF 请求的可信来源,多个值用英文逗号分隔。
CSRF_TRUSTED_ORIGINS=https://localhost:8000

# 是否允许跨域请求携带凭证。
CORS_ALLOW_CREDENTIALS=true

# 是否允许所有跨域来源。开发环境默认放开。
CORS_ORIGIN_ALLOW_ALL=true

# 跨域来源白名单。CORS_ORIGIN_ALLOW_ALL=false 时生效,多个值用英文逗号分隔。
CORS_ALLOWED_ORIGINS=

# MySQL 主机地址。开发环境也使用 MySQL,默认值为占位符。
MYSQL_HOST=dev_mysql_host

# MySQL 端口。
MYSQL_PORT=3306

# MySQL 数据库名。
MYSQL_NAME=dev_mysql_name

# MySQL 用户名。
MYSQL_USER=dev_mysql_user

# MySQL 密码。
MYSQL_PASSWORD=dev_mysql_password

# Redis 主机地址。开发环境也使用 Redis,默认值为占位符。
REDIS_HOST=dev_redis_host

# Redis 端口。
REDIS_PORT=6379

# Redis DB 编号。开发环境默认使用 2,避免与 test/prod 默认 DB 冲突。
REDIS_DB=2

# Redis 密码。无密码时留空。
REDIS_PASSWORD=dev_redis_password

# Redis key 前缀。用于区分不同环境缓存 key。
REDIS_KEY_PREFIX=dev

# Django cache 默认过期时间(秒)。
REDIS_CACHE_TIMEOUT=300

# Redis 连接建立超时(秒)。
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Redis 读写超时(秒)。
REDIS_SOCKET_TIMEOUT=5

# Django 日志级别。dev 默认 DEBUG,便于本地排查。
DJANGO_LOG_LEVEL=DEBUG

# 成功请求日志阈值(毫秒)。0 表示记录所有成功请求。
REQUEST_LOG_SUCCESS_MIN_DURATION_MS=0

# JWT access token 有效期(分钟)。
JWT_ACCESS_TOKEN_TTL_MINUTES=30

# JWT refresh token 有效期(天)。
JWT_REFRESH_TOKEN_TTL_DAYS=7
