# 生产环境配置。settings 会在 Backend.settings.prod 加载时读取本文件。
# 系统环境变量优先级更高；本文件只补默认值。

# Django 签名密钥。
SECRET_KEY={{PROD_SECRET_KEY}}

# 允许访问的 Host,多个值用英文逗号分隔。
ALLOWED_HOSTS={{PROD_ALLOWED_HOSTS}}

# 允许提交 CSRF 请求的可信来源,多个值用英文逗号分隔。
CSRF_TRUSTED_ORIGINS=https://{{PROD_CSRF_TRUSTED_HOSTS}}

# 是否允许跨域请求携带凭证。
CORS_ALLOW_CREDENTIALS=true

# 是否允许所有跨域来源。
CORS_ORIGIN_ALLOW_ALL=false

# 跨域来源白名单。CORS_ORIGIN_ALLOW_ALL=false 时生效,多个值用英文逗号分隔。
CORS_ALLOWED_ORIGINS=

# MySQL 主机地址。
MYSQL_HOST={{PROD_MYSQL_HOST}}

# MySQL 端口。
MYSQL_PORT=3306

# MySQL 数据库名。
MYSQL_NAME={{PROD_MYSQL_NAME}}

# MySQL 用户名。
MYSQL_USER={{PROD_MYSQL_USER}}

# MySQL 密码。
MYSQL_PASSWORD={{PROD_MYSQL_PASSWORD}}

# Redis 主机地址。
REDIS_HOST={{PROD_REDIS_HOST}}

# Redis 端口。
REDIS_PORT=6379

# Redis DB 编号。生产环境默认使用 0。
REDIS_DB=0

# Redis 密码。无密码时留空。
REDIS_PASSWORD={{PROD_REDIS_PASSWORD}}

# Redis key 前缀。用于区分不同环境缓存 key。
REDIS_KEY_PREFIX=prod

# Django cache 默认过期时间(秒)。
REDIS_CACHE_TIMEOUT=300

# Redis 连接建立超时(秒)。
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Redis 读写超时(秒)。
REDIS_SOCKET_TIMEOUT=5

# Django 日志级别。
DJANGO_LOG_LEVEL=INFO

# 成功请求日志阈值(毫秒)。生产环境默认只记录慢成功请求。
REQUEST_LOG_SUCCESS_MIN_DURATION_MS=1000

# JWT access token 有效期(分钟)。
JWT_ACCESS_TOKEN_TTL_MINUTES=30

# JWT refresh token 有效期(天)。
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Gunicorn worker 进程数。生产环境默认 3。
GUNICORN_WORKERS=3

# Gunicorn 每个 worker 的线程数。生产环境默认 2。
GUNICORN_THREADS=2

# Gunicorn 请求超时(秒)。
GUNICORN_TIMEOUT=60

# Gunicorn 日志级别。
GUNICORN_LOG_LEVEL=info
