# Git Hooks 配置(团队默认)
#
# 作用:控制 .husky/ 下的三个 hook(pre-commit / commit-msg / pre-push)是否启用。
# 读取位置:三个 hook 开头通过 scripts/git-hooks/common.sh 加载。
# 优先级:环境变量 > .git-hooks.config.local > .git-hooks.config。
#
# 团队约定:
# - 本文件(`.git-hooks.config`)写团队默认规则,纳入版本控制;
# - 个人机器差异写到 `.git-hooks.config.local`,不提交(已在 .gitignore)。
#
# 设置示例:
#   HOOKS_ENABLED=0            # 总开关关闭,所有 hook 放行(优先级最高)
#   HOOKS_PRE_COMMIT=0         # 仅关闭 pre-commit(保留 commit-msg/pre-push)
#   HOOKS_COMMIT_MSG=0         # 仅关闭 commit-msg
#   HOOKS_PRE_PUSH=0           # 仅关闭 pre-push(跳过构建和单元测试)
#
# 说明:
# - 优先判断总开关 HOOKS_ENABLED:为 0 则三个 hook 全部放行,分项开关失效;
# - 总开关启用时,再看分项开关(默认都是 1,即启用)。
# - 值为 1/true/yes/on 视为启用,0/false/no/off 视为禁用,其余视为禁用。

# ── 总开关(优先级最高) ──
# 默认启用:安装 hooks 后即生效拦截。个人不想启用,在 .local 中覆盖为 0。
HOOKS_ENABLED=1

# ── 分项开关(仅在总开关启用时生效) ──
HOOKS_PRE_COMMIT=1      # pre-commit:增量 lint/format/type-check
HOOKS_COMMIT_MSG=1      # commit-msg:Conventional Commits + 中文主题校验
HOOKS_PRE_PUSH=1        # pre-push:构建 + 全量 lint + 单元测试
